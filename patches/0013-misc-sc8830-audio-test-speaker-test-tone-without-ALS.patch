From 8595379d7cc0fcf2416256c612cf084aae6b0c90 Mon Sep 17 00:00:00 2001
From: gtex-port <igomezv0921@gmail.com>
Date: Sun, 25 Oct 2026 00:45:13 -0600
Subject: [PATCH 13/13] misc: sc8830-audio-test: speaker test tone without ALSA
 or DMA (v17)

Drives the VBC ping-pong buffers, the SC2723S codec and its internal
speaker PA by hand, with the vendor register sequence: a 300 Hz tone for
6 s a few seconds after boot. It plays: the clocks, LDOs, DAC and PA path
work.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 arch/arm/boot/dts/unisoc/sc7730.dtsi |   9 +
 arch/arm/configs/gtexswifi.config    |   2 +
 drivers/misc/Kconfig                 |   9 +
 drivers/misc/Makefile                |   1 +
 drivers/misc/sc8830-audio-test.c     | 459 +++++++++++++++++++++++++++
 5 files changed, 480 insertions(+)
 create mode 100644 drivers/misc/sc8830-audio-test.c

diff --git a/arch/arm/boot/dts/unisoc/sc7730.dtsi b/arch/arm/boot/dts/unisoc/sc7730.dtsi
index c85d375a6..fc7c0606f 100644
--- a/arch/arm/boot/dts/unisoc/sc7730.dtsi
+++ b/arch/arm/boot/dts/unisoc/sc7730.dtsi
@@ -153,6 +153,15 @@ pmic: pmic@40030000 {
 			reg-names = "adi", "pmic";
 		};
 
+		/* Audio bring-up: test tone through VBC + SC2723S codec + speaker PA */
+		audio-test@40020000 {
+			compatible = "sprd,sc8830-audio-test";
+			reg = <0x40020000 0x3000>, <0x40000000 0x2000>,
+			      <0x402e0000 0x4000>, <0x402b0000 0x1000>,
+			      <0x40030000 0x1000>, <0x40038000 0x1000>;
+			reg-names = "vbc", "codec", "aon", "pmu", "adi", "pmic";
+		};
+
 		/* SD card slot (vendor "sdio0") */
 		sdc: mmc@20300000 {
 			compatible = "sprd,sc8830-sdhci";
