diff --git a/arch/arm/boot/dts/unisoc/sc7730-samsung-gtexswifi.dts b/arch/arm/boot/dts/unisoc/sc7730-samsung-gtexswifi.dts
new file mode 100644
index 000000000..bbf9c3a41
--- /dev/null
+++ b/arch/arm/boot/dts/unisoc/sc7730-samsung-gtexswifi.dts
@@ -0,0 +1,82 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Samsung Galaxy Tab A 7.0 (2016) Wi-Fi (SM-T280, gtexswifi)
+ */
+
+/dts-v1/;
+
+#include "sc7730.dtsi"
+
+/ {
+	model = "Samsung Galaxy Tab A 7.0 (2016) Wi-Fi";
+	compatible = "samsung,gtexswifi", "sprd,sc7730";
+	chassis-type = "tablet";
+
+	/* SBOOT picks the DTB out of dt.img by this id and the board revision */
+	sprd,sc-id = <8830 5 0x20000>;
+
+	chosen {
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges;
+
+		/* SBOOT writes its own bootargs here; the kernel uses CONFIG_CMDLINE */
+		bootargs = "";
+
+		/* SBOOT leaves the panel running and scanning out lcd_base */
+		framebuffer@9ea48000 {
+			compatible = "simple-framebuffer";
+			reg = <0x9ea48000 (800 * 1280 * 4)>;
+			width = <800>;
+			height = <1280>;
+			stride = <(800 * 4)>;
+			format = "a8r8g8b8";
+		};
+	};
+
+	memory@80000000 {
+		device_type = "memory";
+		reg = <0x80000000 0x60000000>;
+	};
+
+	reserved-memory {
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges;
+
+		/* Samsung sec_debug and sec_log buffers */
+		sec-log@86a00000 {
+			reg = <0x86a00000 0x200000>;
+			no-map;
+		};
+
+		/* IPC shared memory and modem images loaded by SBOOT */
+		smem@87800000 {
+			reg = <0x87800000 0x400000>;
+			no-map;
+		};
+
+		modem@88000000 {
+			reg = <0x88000000 0x1d00000>;
+			no-map;
+		};
+
+		/* triple-buffered vendor framebuffer, first buffer is lcd_base */
+		framebuffer@9ea48000 {
+			reg = <0x9ea48000 0xbb8000>;
+			no-map;
+		};
+
+		/*
+		 * Vendor ION carveout. TWRP's kernel never touches it, so a
+		 * log left here can be read back from /dev/mem after a reboot.
+		 */
+		ramoops@9f600000 {
+			compatible = "ramoops";
+			reg = <0x9f600000 0x100000>;
+			record-size = <0x20000>;
+			console-size = <0x80000>;
+			no-map;
+		};
+	};
+};
diff --git a/arch/arm/boot/dts/unisoc/sc7730.dtsi b/arch/arm/boot/dts/unisoc/sc7730.dtsi
new file mode 100644
index 000000000..4eee7ba76
--- /dev/null
+++ b/arch/arm/boot/dts/unisoc/sc7730.dtsi
@@ -0,0 +1,91 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Spreadtrum SC7730 (SC8830 family) SoC
+ *
+ * Addresses and interrupts are taken from the vendor 3.10 kernel
+ * (sprd-scx35_3.dtsi).
+ */
+
+#include <dt-bindings/interrupt-controller/arm-gic.h>
+#include <dt-bindings/interrupt-controller/irq.h>
+
+/ {
+	#address-cells = <1>;
+	#size-cells = <1>;
+	interrupt-parent = <&gic>;
+
+	cpus {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		cpu0: cpu@f00 {
+			device_type = "cpu";
+			compatible = "arm,cortex-a7";
+			reg = <0xf00>;
+		};
+
+		cpu1: cpu@f01 {
+			device_type = "cpu";
+			compatible = "arm,cortex-a7";
+			reg = <0xf01>;
+		};
+
+		cpu2: cpu@f02 {
+			device_type = "cpu";
+			compatible = "arm,cortex-a7";
+			reg = <0xf02>;
+		};
+
+		cpu3: cpu@f03 {
+			device_type = "cpu";
+			compatible = "arm,cortex-a7";
+			reg = <0xf03>;
+		};
+	};
+
+	clk32k: clock-32k {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <32768>;
+		clock-output-names = "clk32k";
+	};
+
+	soc {
+		compatible = "simple-bus";
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges;
+
+		gic: interrupt-controller@12001000 {
+			compatible = "arm,cortex-a7-gic";
+			reg = <0x12001000 0x1000>,
+			      <0x12002000 0x2000>;
+			interrupt-controller;
+			#interrupt-cells = <3>;
+		};
+
+		/* AON GPTIMER0; the second range holds the AON APB clock gates */
+		timer@40050000 {
+			compatible = "sprd,sc8830-timer";
+			reg = <0x40050000 0x1000>,
+			      <0x402e0000 0x8>;
+			interrupts = <GIC_SPI 28 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&clk32k>;
+		};
+
+		gpu: gpu@60000000 {
+			compatible = "arm,mali-400";
+			reg = <0x60000000 0x10000>;
+			/* every unit of the MP2 GPU shares one interrupt line */
+			interrupts = <GIC_SPI 39 IRQ_TYPE_LEVEL_HIGH>,
+				     <GIC_SPI 39 IRQ_TYPE_LEVEL_HIGH>,
+				     <GIC_SPI 39 IRQ_TYPE_LEVEL_HIGH>,
+				     <GIC_SPI 39 IRQ_TYPE_LEVEL_HIGH>,
+				     <GIC_SPI 39 IRQ_TYPE_LEVEL_HIGH>,
+				     <GIC_SPI 39 IRQ_TYPE_LEVEL_HIGH>;
+			interrupt-names = "gp", "gpmmu", "pp0", "ppmmu0",
+					  "pp1", "ppmmu1";
+			status = "disabled";
+		};
+	};
+};
diff --git a/arch/arm/configs/gtexswifi.config b/arch/arm/configs/gtexswifi.config
new file mode 100644
index 000000000..51df457fa
--- /dev/null
+++ b/arch/arm/configs/gtexswifi.config
@@ -0,0 +1,70 @@
+# Samsung Galaxy Tab A 7.0 (2016) Wi-Fi (SM-T280), stage 1 "first light".
+# Use on top of allnoconfig:
+#   make ARCH=arm allnoconfig KCONFIG_ALLCONFIG=arch/arm/configs/gtexswifi.config
+
+CONFIG_LOCALVERSION="-gtexswifi"
+# CONFIG_LOCALVERSION_AUTO is not set
+CONFIG_DEFAULT_HOSTNAME="gtexswifi"
+CONFIG_SYSVIPC=y
+CONFIG_POSIX_MQUEUE=y
+CONFIG_NO_HZ_IDLE=y
+CONFIG_HIGH_RES_TIMERS=y
+CONFIG_PREEMPT_VOLUNTARY=y
+CONFIG_IKCONFIG=y
+CONFIG_IKCONFIG_PROC=y
+CONFIG_LOG_BUF_SHIFT=18
+CONFIG_PRINTK_TIME=y
+CONFIG_BLK_DEV_INITRD=y
+CONFIG_KERNEL_XZ=y
+CONFIG_KALLSYMS=y
+CONFIG_PANIC_TIMEOUT=0
+# 32-bit time_t syscalls; allnoconfig drops them, older userspace needs them
+CONFIG_COMPAT_32BIT_TIME=y
+
+# Platform (allnoconfig would even turn the MMU off)
+CONFIG_MMU=y
+CONFIG_ARCH_MULTI_V7=y
+CONFIG_ARCH_SPRD=y
+CONFIG_SMP=y
+CONFIG_NR_CPUS=4
+CONFIG_HIGHMEM=y
+CONFIG_VFP=y
+CONFIG_NEON=y
+CONFIG_KERNEL_MODE_NEON=y
+CONFIG_ARM_THUMB=y
+CONFIG_ARM_UNWIND=y
+
+# Boot: our DTB is appended to zImage, so SBOOT's copy and cmdline are ignored
+CONFIG_ARM_APPENDED_DTB=y
+CONFIG_ARM_ATAG_DTB_COMPAT=y
+CONFIG_CMDLINE="console=tty0 loglevel=8 ignore_loglevel panic=0 fbcon=nodefer"
+CONFIG_CMDLINE_FORCE=y
+
+# Display: the panel keeps scanning out the bootloader framebuffer
+CONFIG_DRM=y
+CONFIG_DRM_SIMPLEDRM=y
+CONFIG_DRM_FBDEV_EMULATION=y
+CONFIG_FB=y
+CONFIG_VT=y
+CONFIG_VT_CONSOLE=y
+CONFIG_FRAMEBUFFER_CONSOLE=y
+# fbcon goes through a shadow buffer that a worker copies to the screen;
+# after a panic that worker never runs, so draw panics straight to it
+CONFIG_DRM_PANIC=y
+CONFIG_DRM_PANIC_SCREEN="kmsg"
+
+# Built-in bring-up initramfs with our own tiny /init
+CONFIG_INITRAMFS_SOURCE="/home/nigga/batocera-t280/initramfs/initramfs.list"
+
+# Crash log kept in RAM, read back from TWRP via /dev/mem
+CONFIG_MISC_FILESYSTEMS=y
+CONFIG_PSTORE=y
+CONFIG_PSTORE_CONSOLE=y
+CONFIG_PSTORE_RAM=y
+
+# Userspace basics
+CONFIG_BINFMT_ELF=y
+CONFIG_BINFMT_SCRIPT=y
+CONFIG_DEVTMPFS=y
+CONFIG_DEVTMPFS_MOUNT=y
+CONFIG_TMPFS=y
