From cb8a045181936a86af5d2883959bd3a5f270bcd2 Mon Sep 17 00:00:00 2001
From: gtex-port <igomezv0921@gmail.com>
Date: Sat, 24 Oct 2026 17:37:23 -0600
Subject: [PATCH 08/11] pmdomain: sc8830-gpu-pd: open the 384 MHz source gate
 (v11)

---
 arch/arm/boot/dts/unisoc/sc7730.dtsi  |  8 ++++++--
 drivers/pmdomain/sprd/sc8830-gpu-pd.c | 27 +++++++++++++++++++--------
 2 files changed, 25 insertions(+), 10 deletions(-)

diff --git a/arch/arm/boot/dts/unisoc/sc7730.dtsi b/arch/arm/boot/dts/unisoc/sc7730.dtsi
index 8a91d7bb7..7147b0299 100644
--- a/arch/arm/boot/dts/unisoc/sc7730.dtsi
+++ b/arch/arm/boot/dts/unisoc/sc7730.dtsi
@@ -117,13 +117,17 @@ emmc: mmc@20600000 {
 			status = "disabled";
 		};
 
-		/* PMU PD_GPU_TOP_CFG, AON APB_EB0 (shared), GPU APB */
+		/*
+		 * PMU PD_GPU_TOP_CFG, AON APB_EB0 (shared), the PMU gates of the
+		 * GPU clock sources and the GPU APB block
+		 */
 		gpu_pd: power-controller@402b0020 {
 			compatible = "sprd,sc8830-gpu-pd";
 			reg = <0x402b0020 0x4>,
 			      <0x402e0000 0x4>,
+			      <0x402b011c 0x4>,
 			      <0x60100000 0x8>;
-			reg-names = "pmu", "aon", "gpu";
+			reg-names = "pmu", "aon", "gate", "gpu";
 			#power-domain-cells = <0>;
 		};
 
diff --git a/drivers/pmdomain/sprd/sc8830-gpu-pd.c b/drivers/pmdomain/sprd/sc8830-gpu-pd.c
index e4a90557c..ca8e55c46 100644
--- a/drivers/pmdomain/sprd/sc8830-gpu-pd.c
+++ b/drivers/pmdomain/sprd/sc8830-gpu-pd.c
@@ -6,6 +6,9 @@
  * (chip_x30g/__clock_tree.h: clk_gpu_top_i, clk_gpu_i, clk_gpu):
  *  - PMU APB PD_GPU_TOP_CFG: clear FORCE_SHUTDOWN (and AUTO_SHUTDOWN_EN);
  *  - AON APB APB_EB0: set GPU_EB;
+ *  - PMU APB 0x11c: open the gate of the 384 MHz source towards the GPU
+ *    (vendor scx30g3-clocks.dtsi, clk_384m_gpu_gate). Without it the Mali
+ *    registers hang the bus;
  *  - GPU APB APB_CLK_CTRL: select the 384 MHz parent, divider 1.
  * The domain is kept always on for now.
  */
@@ -19,6 +22,7 @@
 #define SC8830_PD_GPU_TOP_FORCE_SHUTDOWN	BIT(25)
 #define SC8830_PD_GPU_TOP_AUTO_SHUTDOWN_EN	BIT(24)
 #define SC8830_AON_APB_EB0_GPU_EB		BIT(27)
+#define SC8830_PMU_GPU_GATE_384M		BIT(5)
 #define SC8830_GPU_APB_CLK_CTRL			0x4
 #define SC8830_GPU_CLK_SEL_MASK			GENMASK(2, 0)
 #define SC8830_GPU_CLK_DIV_MASK			GENMASK(5, 4)
@@ -28,6 +32,7 @@ struct sc8830_gpu_pd {
 	struct generic_pm_domain genpd;
 	void __iomem *pmu;
 	void __iomem *aon;
+	void __iomem *gate;
 	void __iomem *gpu;
 };
 
@@ -50,14 +55,17 @@ static int sc8830_gpu_pd_power_on(struct generic_pm_domain *genpd)
 {
 	struct sc8830_gpu_pd *pd = container_of(genpd, struct sc8830_gpu_pd, genpd);
 
-	sc8830_gpu_pd_step(genpd, "paso 1/3: energia (PD_GPU_TOP)");
+	sc8830_gpu_pd_step(genpd, "paso 1/4: energia (PD_GPU_TOP)");
 	sc8830_gpu_pd_rmw(pd->pmu, SC8830_PD_GPU_TOP_FORCE_SHUTDOWN |
 			  SC8830_PD_GPU_TOP_AUTO_SHUTDOWN_EN, 0);
 	usleep_range(200, 300);
-	sc8830_gpu_pd_step(genpd, "paso 2/3: habilitar (GPU_EB)");
+	sc8830_gpu_pd_step(genpd, "paso 2/4: habilitar (GPU_EB)");
 	sc8830_gpu_pd_rmw(pd->aon, 0, SC8830_AON_APB_EB0_GPU_EB);
 	usleep_range(10, 20);
-	sc8830_gpu_pd_step(genpd, "paso 3/3: reloj 384 MHz (GPU APB)");
+	sc8830_gpu_pd_step(genpd, "paso 3/4: compuerta de 384 MHz (PMU 0x11c)");
+	sc8830_gpu_pd_rmw(pd->gate, 0, SC8830_PMU_GPU_GATE_384M);
+	usleep_range(10, 20);
+	sc8830_gpu_pd_step(genpd, "paso 4/4: seleccionar 384 MHz (GPU APB)");
 	sc8830_gpu_pd_rmw(pd->gpu + SC8830_GPU_APB_CLK_CTRL,
 			  SC8830_GPU_CLK_SEL_MASK | SC8830_GPU_CLK_DIV_MASK,
 			  SC8830_GPU_CLK_SEL_384M);
@@ -92,25 +100,28 @@ static int sc8830_gpu_pd_probe(struct platform_device *pdev)
 
 	pd->pmu = sc8830_gpu_pd_map(pdev, "pmu");
 	pd->aon = sc8830_gpu_pd_map(pdev, "aon");
+	pd->gate = sc8830_gpu_pd_map(pdev, "gate");
 	pd->gpu = sc8830_gpu_pd_map(pdev, "gpu");
-	if (IS_ERR(pd->pmu) || IS_ERR(pd->aon) || IS_ERR(pd->gpu))
+	if (IS_ERR(pd->pmu) || IS_ERR(pd->aon) || IS_ERR(pd->gate) ||
+	    IS_ERR(pd->gpu))
 		return -EINVAL;
 
 	/*
 	 * Only the always-on PMU and AON registers here: the GPU APB block
 	 * sits inside the domain and must not be touched while it is off.
 	 */
-	dev_info(&pdev->dev, "before: pd_cfg %08x eb0 %08x\n",
-		 readl(pd->pmu), readl(pd->aon));
+	dev_info(&pdev->dev, "before: pd_cfg %08x eb0 %08x gate %08x\n",
+		 readl(pd->pmu), readl(pd->aon), readl(pd->gate));
 
 	pd->genpd.name = "gpu";
 	pd->genpd.power_on = sc8830_gpu_pd_power_on;
 	pd->genpd.flags = GENPD_FLAG_ALWAYS_ON;
 	sc8830_gpu_pd_power_on(&pd->genpd);
 
-	dev_info(&pdev->dev, "after:  pd_cfg %08x eb0 %08x clk %08x rst %08x\n",
-		 readl(pd->pmu), readl(pd->aon),
+	dev_info(&pdev->dev, "after:  pd_cfg %08x eb0 %08x gate %08x clk %08x rst %08x\n",
+		 readl(pd->pmu), readl(pd->aon), readl(pd->gate),
 		 readl(pd->gpu + SC8830_GPU_APB_CLK_CTRL), readl(pd->gpu));
+	msleep(200);
 
 	ret = pm_genpd_init(&pd->genpd, NULL, false);
 	if (ret)
-- 
2.56.0

