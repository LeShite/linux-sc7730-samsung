From d9fe51e611096dfde0d81740a233f53a709dba5c Mon Sep 17 00:00:00 2001
From: gtex-port <igomezv0921@gmail.com>
Date: Sun, 25 Oct 2026 21:02:35 -0600
Subject: [PATCH] sc2723: keep the fuel gauge on, restart through the PMIC
 watchdog (v54, v55)

v53 left the gauge frozen (1191 mV, -2666 mA): FGU_EN in the PMIC's
ARM_MODULE_EN was found cleared (0x0239 instead of 0x037a). The efuse read
restored a saved copy of that shared register; it now flips only its own bit,
and the gauge puts FGU_EN and its clocks back (and logs) if they go missing.
It never saves a percentage from a nonsense reading, and reports Charging
whenever the charger supplies it.

Restart: "reboot" hung the board (no restart handler). The vendor's
sys_reset.c: boot mode in POR_RST_MONITOR (recovery 0x20, normal 0x40), then
the PMIC watchdog with a short count. "reboot recovery" now boots TWRP.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/power/supply/sc2723-fgu.c    | 49 ++++++++++++++++++++++++----
 drivers/regulator/sc2723-regulator.c | 45 +++++++++++++++++++++++++
 2 files changed, 87 insertions(+), 7 deletions(-)

diff --git a/drivers/power/supply/sc2723-fgu.c b/drivers/power/supply/sc2723-fgu.c
index 05c4316f5..0e7d3dbd6 100644
--- a/drivers/power/supply/sc2723-fgu.c
+++ b/drivers/power/supply/sc2723-fgu.c
@@ -52,6 +52,10 @@
 #define  EFUSE_READ_BUSY	BIT(1)
 #define ANA_GLB_ARM_MODULE_EN	0x0800
 #define  ANA_EFS_EN		BIT(7)
+#define  ANA_FGU_EN		BIT(8)
+#define ANA_GLB_RTC_CLK_EN	0x0808
+#define  RTC_FGU_EN		BIT(7)
+#define  RTC_FGUA_EN		BIT(6)
 
 /* ADI controller (0x40030000), as in sc2723-regulator.c */
 #define ADI_GSSI_CFG0		0x1c
@@ -105,6 +109,33 @@ static void adi_write(struct sc2723_fgu *f, u32 reg, u16 val)
 	readl_poll_timeout_atomic(f->adi + ADI_FIFO_STS, sts, sts & ADI_FIFO_EMPTY, 1, 1000);
 }
 
+/* set or clear only these bits, re-reading the register right before (other drivers share it) */
+static void adi_bits(struct sc2723_fgu *f, u32 reg, u16 bits, bool on)
+{
+	u16 v;
+
+	if (!adi_read(f, reg, &v))
+		adi_write(f, reg, on ? v | bits : v & ~bits);
+}
+
+/*
+ * The FGU's module enable and clocks in the PMIC globals. Something once cleared FGU_EN after
+ * probe (MODULE_EN read 0x0239 instead of 0x037a): the gauge then returned a frozen reading.
+ * Put them back and say what they were, so the culprit can be found.
+ */
+static void fgu_keep_enabled(struct sc2723_fgu *f)
+{
+	u16 mod, rtc;
+
+	if (adi_read(f, ANA_GLB_ARM_MODULE_EN, &mod) || adi_read(f, ANA_GLB_RTC_CLK_EN, &rtc))
+		return;
+	if ((mod & ANA_FGU_EN) && (rtc & (RTC_FGU_EN | RTC_FGUA_EN)) == (RTC_FGU_EN | RTC_FGUA_EN))
+		return;
+	dev_warn_ratelimited(f->dev, "FGU was off (MODULE_EN %04x RTC_CLK_EN %04x): back on\n", mod, rtc);
+	adi_bits(f, ANA_GLB_ARM_MODULE_EN, ANA_FGU_EN, true);
+	adi_bits(f, ANA_GLB_RTC_CLK_EN, RTC_FGU_EN | RTC_FGUA_EN, true);
+}
+
 /* the FGU updates its registers on its own: read until two reads agree */
 static int fgu_get(struct sc2723_fgu *f, u32 reg)
 {
@@ -171,12 +202,10 @@ static int capacity(struct sc2723_fgu *f)
 /* one 8-bit efuse block, inverted as the vendor's adie_efuse_read() returns it */
 static int efuse_read(struct sc2723_fgu *f, int blk)
 {
-	u16 v = 0, sts, mod;
+	u16 v = 0, sts;
 	int i;
 
-	if (adi_read(f, ANA_GLB_ARM_MODULE_EN, &mod))
-		return -EIO;
-	adi_write(f, ANA_GLB_ARM_MODULE_EN, mod | ANA_EFS_EN);
+	adi_bits(f, ANA_GLB_ARM_MODULE_EN, ANA_EFS_EN, true);
 	adi_write(f, EFUSE_BLOCK_INDEX, blk & 0x1f);
 	adi_write(f, EFUSE_MODE_CTRL, EFUSE_RD_START);
 	for (i = 0; i < 1000; i++) {
@@ -185,7 +214,7 @@ static int efuse_read(struct sc2723_fgu *f, int blk)
 		udelay(10);
 	}
 	adi_read(f, EFUSE_DATA_RD, &v);
-	adi_write(f, ANA_GLB_ARM_MODULE_EN, mod);
+	adi_bits(f, ANA_GLB_ARM_MODULE_EN, ANA_EFS_EN, false);
 	return (~v) & 0xff;
 }
 
@@ -219,7 +248,10 @@ static void save_work(struct work_struct *work)
 	struct sc2723_fgu *f = container_of(work, struct sc2723_fgu, save.work);
 
 	mutex_lock(&f->lock);
-	save_soc(f, capacity(f));
+	fgu_keep_enabled(f);
+	/* never save from a gauge that reads nonsense: the next boot would start from it */
+	if (read_mv(f) > 3000)
+		save_soc(f, capacity(f));
 	mutex_unlock(&f->lock);
 	schedule_delayed_work(&f->save, SAVE_INTERVAL_S * HZ);
 }
@@ -241,6 +273,7 @@ static int sc2723_fgu_get(struct power_supply *psy, enum power_supply_property p
 	int ret = 0, ma, cap;
 
 	mutex_lock(&f->lock);
+	fgu_keep_enabled(f);
 	switch (psp) {
 	case POWER_SUPPLY_PROP_STATUS:
 		ma = read_ma(f);
@@ -248,9 +281,10 @@ static int sc2723_fgu_get(struct power_supply *psy, enum power_supply_property p
 		/* with a charger driver (sm5701-charger supplies "battery"), trust its cable sense */
 		ret = power_supply_am_i_supplied(psy);
 		if (ret >= 0) {
+			/* plugged in = charging, as Android shows it, even when a PC port gives less than the tablet draws */
 			if (ret && cap >= 100)
 				val->intval = POWER_SUPPLY_STATUS_FULL;
-			else if (ret && ma > -50)
+			else if (ret)
 				val->intval = POWER_SUPPLY_STATUS_CHARGING;
 			else
 				val->intval = POWER_SUPPLY_STATUS_DISCHARGING;
@@ -343,6 +377,7 @@ static int sc2723_fgu_probe(struct platform_device *pdev)
 
 	of_property_read_u32_array(dev->of_node, "sprd,rsense", rsense, 2);	/* real, spec */
 	calibrate(f, rsense[0], rsense[1]);
+	fgu_keep_enabled(f);
 
 	f->cnom_mah = 3950;	/* until the battery info is read: the property callbacks may run */
 	cfg.drv_data = f;
diff --git a/drivers/regulator/sc2723-regulator.c b/drivers/regulator/sc2723-regulator.c
index 75f41cd85..d4e3091bc 100644
--- a/drivers/regulator/sc2723-regulator.c
+++ b/drivers/regulator/sc2723-regulator.c
@@ -30,6 +30,7 @@
 #include <linux/regulator/driver.h>
 #include <linux/regulator/of_regulator.h>
 #include <linux/spinlock.h>
+#include <linux/string.h>
 
 #define ADI_GSSI_CFG0		0x1c
 #define ADI_RD_CMD		0x24
@@ -47,6 +48,23 @@
 #define  PWR_WR_PROT		BIT(15)
 #define  PWR_WR_PROT_KEY	0x6e7f
 
+/* restart (vendor sys_reset.c): the boot mode for the bootloader, then the PMIC watchdog */
+#define ANA_GLB_ARM_MODULE_EN	0x0800
+#define  ANA_WDG_EN		BIT(2)
+#define ANA_GLB_RTC_CLK_EN	0x0808
+#define  RTC_WDG_EN		BIT(2)
+#define ANA_GLB_POR_RST_MONITOR	0x0924
+#define  HWRST_RECOVERY		0x20
+#define  HWRST_NORMAL		0x40
+#define WDG_LOAD_LOW		0x0040
+#define WDG_LOAD_HIGH		0x0044
+#define WDG_CTRL		0x0048
+#define  WDG_CNT_EN		BIT(1)
+#define  WDG_NEW_VER_EN		BIT(2)
+#define  WDG_RST_EN		BIT(3)
+#define WDG_LOCK		0x0060
+#define  WDG_UNLOCK_KEY		0xe551
+
 #define SC2723_LDO_MIN_UV	1200000
 #define SC2723_LDO_STEP_UV	10000
 
@@ -134,6 +152,30 @@ static int sc2723_power_off(struct sys_off_data *data)
 	return NOTIFY_DONE;
 }
 
+/*
+ * sprd_set_reboot_mode() and sprd_turnon_watchdog(): "reboot recovery" boots TWRP, anything else
+ * a normal boot; the watchdog (32768 Hz) fires after ~20 ms and resets the whole board.
+ */
+static int sc2723_restart(struct sys_off_data *data)
+{
+	struct sc2723 *pmic = data->cb_data;
+	const char *cmd = data->cmd;
+	u32 cnt = 32768 / 50;
+
+	sc2723_write(pmic, ANA_GLB_POR_RST_MONITOR,
+		     cmd && !strncmp(cmd, "recovery", 8) ? HWRST_RECOVERY : HWRST_NORMAL);
+	sc2723_update(pmic, ANA_GLB_ARM_MODULE_EN, ANA_WDG_EN, ANA_WDG_EN);
+	sc2723_update(pmic, ANA_GLB_RTC_CLK_EN, RTC_WDG_EN, RTC_WDG_EN);
+	sc2723_write(pmic, WDG_LOCK, WDG_UNLOCK_KEY);
+	sc2723_update(pmic, WDG_CTRL, WDG_NEW_VER_EN, WDG_NEW_VER_EN);
+	sc2723_write(pmic, WDG_LOAD_HIGH, cnt >> 16);
+	sc2723_write(pmic, WDG_LOAD_LOW, cnt & 0xffff);
+	sc2723_update(pmic, WDG_CTRL, WDG_CNT_EN | WDG_RST_EN, WDG_CNT_EN | WDG_RST_EN);
+	sc2723_write(pmic, WDG_LOCK, (u16)~WDG_UNLOCK_KEY);
+	mdelay(1000);
+	return NOTIFY_DONE;
+}
+
 static struct sc2723_ldo *rdev_to_ldo(struct regulator_dev *rdev)
 {
 	return container_of(rdev->desc, struct sc2723_ldo, desc);
@@ -289,6 +331,9 @@ static int sc2723_probe(struct platform_device *pdev)
 	ret = devm_register_power_off_handler(&pdev->dev, sc2723_power_off, pmic);
 	if (ret)
 		dev_warn(&pdev->dev, "no power-off handler: %d\n", ret);
+	ret = devm_register_restart_handler(&pdev->dev, sc2723_restart, pmic);
+	if (ret)
+		dev_warn(&pdev->dev, "no restart handler: %d\n", ret);
 	return 0;
 }
 
-- 
2.56.0

