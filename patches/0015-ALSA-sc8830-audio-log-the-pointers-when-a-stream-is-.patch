From d9f3fb48700f8bb88828f21ec9ccfe5e1e014b42 Mon Sep 17 00:00:00 2001
From: gtex-port <igomezv0921@gmail.com>
Date: Sun, 25 Oct 2026 07:38:59 -0600
Subject: [PATCH] ALSA: sc8830-audio: log the pointers when a stream is stopped
 while running (v36)

A bring-up aid: when the trigger stops a stream that is still RUNNING
(an xrun, or an idle stream being closed), print the hardware and the
application pointer, the buffer and the period. On the tablet the stops
seen were idle PipeWire/EmulationStation streams that never received
data (appl=0), not audible cuts.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 sound/arm/sc8830-audio.c | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/sound/arm/sc8830-audio.c b/sound/arm/sc8830-audio.c
index a8b3dec2a..105179bbd 100644
--- a/sound/arm/sc8830-audio.c
+++ b/sound/arm/sc8830-audio.c
@@ -707,6 +707,16 @@ static int sc8830_pcm_trigger(struct snd_pcm_substream *substream, int cmd)
 		    VBENABLE | VBDA0DMA_EN | VBDA1DMA_EN);
 		return 0;
 	case SNDRV_PCM_TRIGGER_STOP:
+		{
+			struct snd_pcm_runtime *rt = substream->runtime;
+
+			/* an xrun stops the stream from here: tell the two pointers apart from a normal stop */
+			if (rt->status->state == SNDRV_PCM_STATE_RUNNING)
+				dev_info_ratelimited(sa->dev, "stop while running (xrun?): hw=%lu appl=%lu buffer=%lu period=%lu\n",
+						     (unsigned long)rt->status->hw_ptr,
+						     (unsigned long)rt->control->appl_ptr,
+						     rt->buffer_size, rt->period_size);
+		}
 		upd(sa->vbc, VBDABUFFDTA, VBENABLE | VBDA0DMA_EN | VBDA1DMA_EN, 0);
 		upd(sa->vbc, VBCHNEN, VBDA0_EN | VBDA1_EN, 0);
 		dma_stop_channel(sa, 0);
