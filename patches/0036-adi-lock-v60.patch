-	if (ret)
-		return ret;
-	writel((v & ~mask) | set, c->pmic + reg);
-	return readl_poll_timeout_atomic(c->adi + ADI_FIFO_STS, sts, sts & ADI_FIFO_EMPTY, 1, 1000);
+	raw_spin_lock_irqsave(&sc8830_adi_lock, flags);
+	ret = __adi_read(c, reg, &v);
+	if (!ret) {
+		writel((v & ~mask) | set, c->pmic + reg);
