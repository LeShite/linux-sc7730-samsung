From c7704cf2e2d0a9018bfa9547a361447f6eafe535 Mon Sep 17 00:00:00 2001
From: gtex-port <igomezv0921@gmail.com>
Date: Mon, 26 Oct 2026 00:52:29 -0600
Subject: [PATCH] sc8830: one lock for the ADI bus; audio never writes back a
 failed read; cpuclk thermal brake (v60)

The audio, fuel gauge, regulator, keys and cpuclk drivers each locked only
themselves while sharing the ADI read command/data pair, so reads got each
other's data. A failed read made sc8830-audio write PMU0 back as 0x2000 and the
speaker went silent (also the likely cause of the fuel gauge losing FGU_EN).
Reads and read-modify-writes now hold sc8830_adi_lock; the audio driver retries
and leaves the register alone when it cannot read it. cpuclk drops to 1300 MHz
above 80 C and returns below 68 C.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 drivers/input/keyboard/sc8830-keys.c |  28 ++++++--
 drivers/misc/Makefile                |   1 +
 drivers/misc/sc8830-adi-lock.c       |   6 ++
 drivers/power/supply/sc2723-fgu.c    |  28 +++++++-
 drivers/regulator/sc2723-regulator.c |  38 ++++++----
 drivers/thermal/sc8830-cpuclk.c      | 102 +++++++++++++++++++++------
 include/linux/sc8830-adi.h           |  15 ++++
 sound/arm/sc8830-audio.c             |  21 ++++--
 8 files changed, 191 insertions(+), 48 deletions(-)
 create mode 100644 drivers/misc/sc8830-adi-lock.c
 create mode 100644 include/linux/sc8830-adi.h

diff --git a/drivers/input/keyboard/sc8830-keys.c b/drivers/input/keyboard/sc8830-keys.c
index 035573a72..232609792 100644
--- a/drivers/input/keyboard/sc8830-keys.c
+++ b/drivers/input/keyboard/sc8830-keys.c
@@ -20,6 +20,7 @@
 #include <linux/module.h>
 #include <linux/of.h>
 #include <linux/platform_device.h>
+#include <linux/sc8830-adi.h>
 #include <linux/workqueue.h>
 
 /* keypad controller (0x40250000) */
@@ -80,6 +81,7 @@ struct sc8830_keys {
 	bool power, voldown;
 };
 
+/* the caller holds sc8830_adi_lock */
 static int adi_read(struct sc8830_keys *k, u32 reg, u16 *val)
 {
 	u32 phys = k->pmic_phys + reg, data;
@@ -99,13 +101,27 @@ static int adi_read(struct sc8830_keys *k, u32 reg, u16 *val)
 /* read-modify-write; the audio driver touches other bits of the same registers under its own lock */
 static void adi_set(struct sc8830_keys *k, u32 reg, u16 bits)
 {
+	unsigned long flags;
 	u16 old;
 	u32 sts;
 
-	if (adi_read(k, reg, &old))
-		return;
-	writel(old | bits, k->pmic + reg);
-	readl_poll_timeout_atomic(k->adi + ADI_FIFO_STS, sts, sts & ADI_FIFO_EMPTY, 1, 1000);
+	raw_spin_lock_irqsave(&sc8830_adi_lock, flags);
+	if (!adi_read(k, reg, &old)) {
+		writel(old | bits, k->pmic + reg);
+		readl_poll_timeout_atomic(k->adi + ADI_FIFO_STS, sts, sts & ADI_FIFO_EMPTY, 1, 1000);
+	}
+	raw_spin_unlock_irqrestore(&sc8830_adi_lock, flags);
+}
+
+static int adi_get(struct sc8830_keys *k, u32 reg, u16 *val)
+{
+	unsigned long flags;
+	int ret;
+
+	raw_spin_lock_irqsave(&sc8830_adi_lock, flags);
+	ret = adi_read(k, reg, val);
+	raw_spin_unlock_irqrestore(&sc8830_adi_lock, flags);
+	return ret;
 }
 
 static void upd(void __iomem *base, u32 reg, u32 mask, u32 val)
@@ -137,7 +153,7 @@ static void poll_work(struct work_struct *work)
 	u16 eic;
 	int i;
 
-	if (!adi_read(k, ANA_EIC_DATA, &eic) && eic == k->eic_last) {
+	if (!adi_get(k, ANA_EIC_DATA, &eic) && eic == k->eic_last) {
 		bool power = (eic ^ k->eic_idle) & BIT(EIC_POWER);
 		bool voldown = (eic ^ k->eic_idle) & BIT(EIC_VOLDOWN);
 
@@ -213,7 +229,7 @@ static int sc8830_keys_probe(struct platform_device *pdev)
 	adi_set(k, ANA_GLB_RTC_CLK_EN, RTC_EIC_EN);
 	adi_set(k, ANA_EIC_DMSK, BIT(EIC_POWER) | BIT(EIC_VOLDOWN));
 	udelay(100);
-	ret = adi_read(k, ANA_EIC_DATA, &k->eic_idle);
+	ret = adi_get(k, ANA_EIC_DATA, &k->eic_idle);
 	if (ret)
 		return dev_err_probe(dev, ret, "cannot read the analog EIC\n");
 	/*
