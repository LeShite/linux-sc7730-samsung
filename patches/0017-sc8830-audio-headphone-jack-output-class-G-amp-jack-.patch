 #define  DACL_AOL		BIT(13)
 #define  DACR_AOL		BIT(12)
+#define ANA_CDC7		0x0638
+#define  HPL_CGL		BIT(11)
+#define  HPR_CGR		BIT(10)
+#define  DACL_P_HPL		BIT(7)
+#define  DACR_P_HPR		BIT(2)
