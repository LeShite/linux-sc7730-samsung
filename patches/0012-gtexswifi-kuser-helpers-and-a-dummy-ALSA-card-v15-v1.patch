From e4834d7e4766bd45512b69171b11a943a94d49ac Mon Sep 17 00:00:00 2001
From: gtex-port <igomezv0921@gmail.com>
Date: Sun, 25 Oct 2026 00:45:13 -0600
Subject: [PATCH 12/13] gtexswifi: kuser helpers and a dummy ALSA card (v15,
 v16)

allnoconfig had turned CONFIG_KUSER_HELPERS off: glibc reads the helper
version at 0xffff0ffc and python3, wireplumber and lircd died with
SIGSEGV. A dummy sound card lets VICE, RetroArch and Batocera's audio
setup find an ALSA device until the codec has a driver.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 arch/arm/configs/gtexswifi.config | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/arch/arm/configs/gtexswifi.config b/arch/arm/configs/gtexswifi.config
index 3b00adbca..9bcdd195c 100644
--- a/arch/arm/configs/gtexswifi.config
+++ b/arch/arm/configs/gtexswifi.config
@@ -33,6 +33,18 @@ CONFIG_NEON=y
 CONFIG_KERNEL_MODE_NEON=y
 CONFIG_ARM_THUMB=y
 CONFIG_ARM_UNWIND=y
+# Vector-page helpers (kuser): glibc/libgcc read the helper version at 0xffff0ffc and any
+# process that does so is killed with SIGSEGV when this is off (python3, wireplumber, lircd)
+CONFIG_KUSER_HELPERS=y
+
+# Sound: no codec driver yet, so a virtual ALSA card that swallows the audio. Without any card
+# VICE aborts ("sound initialization failed for device alsa") and Batocera's audio setup waits ~20 s
+CONFIG_SOUND=y
+CONFIG_SND=y
+CONFIG_SND_PROC_FS=y
+CONFIG_SND_DRIVERS=y
+CONFIG_SND_PCM_TIMER=y
+CONFIG_SND_DUMMY=y
 
 # Boot: our DTB is appended to zImage, so SBOOT's copy and cmdline are ignored
 CONFIG_ARM_APPENDED_DTB=y
