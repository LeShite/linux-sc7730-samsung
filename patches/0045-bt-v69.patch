From: gtex-port <igomezv0921@gmail.com>
Date: Mon, 26 Oct 2026 21:30:02 -0600
Subject: [PATCH] Bluetooth of the Marlin chip: HCI H4 over UART0 at 3 Mbaud
 with the vendor pskey command (v69)

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 arch/arm/configs/gtexswifi.config |  12 ++
 drivers/misc/sprd-marlin-sdio.c   |  54 +++++++-
 drivers/misc/sprd-sc2331-marlin.c | 208 +++++++++++++++++++++++++++++-
 drivers/misc/sprd-sc2331-wlan.c   |   2 +-
 include/linux/sprd-marlin-sdio.h  |  10 ++
 5 files changed, 282 insertions(+), 4 deletions(-)

diff --git a/arch/arm/configs/gtexswifi.config b/arch/arm/configs/gtexswifi.config
index cc3c724ad..d289d46c5 100644
--- a/arch/arm/configs/gtexswifi.config
+++ b/arch/arm/configs/gtexswifi.config
@@ -191,3 +191,15 @@ CONFIG_CFG80211=y
 # CONFIG_CFG80211_REQUIRE_SIGNED_REGDB is not set
 # CONFIG_CFG80211_USE_KERNEL_REGDB_KEYS is not set
 CONFIG_SPRD_SC2331_WLAN=y
+# Bluetooth of the Marlin chip: HCI (H4) over UART0, BlueZ in Batocera, HID gamepads
+CONFIG_BT=y
+CONFIG_BT_BREDR=y
+CONFIG_BT_LE=y
+CONFIG_BT_RFCOMM=y
+CONFIG_BT_HIDP=y
+CONFIG_BT_HCIUART=y
+CONFIG_BT_HCIUART_SERDEV=y
+CONFIG_BT_HCIUART_H4=y
+CONFIG_HID=y
+CONFIG_HID_GENERIC=y
+CONFIG_UHID=y
diff --git a/drivers/misc/sprd-marlin-sdio.c b/drivers/misc/sprd-marlin-sdio.c
index 071b57971..7b91df7a7 100644
--- a/drivers/misc/sprd-marlin-sdio.c
+++ b/drivers/misc/sprd-marlin-sdio.c
@@ -46,6 +46,7 @@ struct marlin_sdio {
 	struct mutex lock;
 	wait_queue_head_t wait;
 	bool irq_seen;
+	atomic_t hold;			/* users that need the chip awake (Bluetooth) */
 	void (*irq_cb)(void *);
 	void *irq_cb_data;
 	u8 *buf;
@@ -145,8 +146,25 @@ int marlin_sdio_wake(struct marlin_sdio *m)
 	return -ETIMEDOUT;
 }
 
+void marlin_sdio_hold_awake(struct marlin_sdio *m, bool hold)
+{
+	if (hold) {
+		atomic_inc(&m->hold);
+		marlin_sdio_wake(m);
+	} else {
+		atomic_dec_if_positive(&m->hold);
+	}
+}
+
+bool marlin_sdio_held(struct marlin_sdio *m)
+{
+	return atomic_read(&m->hold) > 0;
+}
+
 void marlin_sdio_sleep(struct marlin_sdio *m)
 {
+	if (atomic_read(&m->hold) > 0)
+		return;
 	if (m->wake_out)
 		gpiod_set_value(m->wake_out, 0);
 }
@@ -293,6 +311,37 @@ static ssize_t wlan_store(struct device *dev, struct device_attribute *attr, con
 }
 static DEVICE_ATTR_WO(wlan);
 
+/* echo "1 aa:bb:cc:dd:ee:ff" > bt registers the Bluetooth controller (BD address given); 0 removes it */
+static ssize_t bt_store(struct device *dev, struct device_attribute *attr, const char *buf, size_t n)
+{
+	struct marlin_sdio *m = marlin;
+	u8 mac[ETH_ALEN], bd[ETH_ALEN];
+	bool on, have_mac = false;
+	char word[4] = { 0 };
+	int ret, i;
+
+	if (sscanf(buf, "%3s", word) != 1 || kstrtobool(word, &on))
+		return -EINVAL;
+	if (on && strchr(buf, ' ') &&
+	    sscanf(strchr(buf, ' ') + 1, "%hhx:%hhx:%hhx:%hhx:%hhx:%hhx", &mac[0], &mac[1], &mac[2], &mac[3], &mac[4], &mac[5]) == 6)
+		have_mac = true;
+	if (!m)
+		return -ENODEV;
+	if (!on) {
+		sprd_marlin_bt_stop();
+		marlin_sdio_hold_awake(m, false);
+		return n;
+	}
+	for (i = 0; i < ETH_ALEN; i++)		/* HCI wants the address least significant byte first */
+		bd[i] = mac[ETH_ALEN - 1 - i];
+	marlin_sdio_hold_awake(m, true);	/* the chip must not sleep with Bluetooth running */
+	ret = sprd_marlin_bt_start(have_mac ? bd : NULL);
+	if (ret)
+		marlin_sdio_hold_awake(m, false);
+	return ret ?: n;
+}
+static DEVICE_ATTR_WO(bt);
+
 static int marlin_probe(struct sdio_func *func, const struct sdio_device_id *id)
 {
 	struct device_node *np = of_find_compatible_node(NULL, NULL, "sprd,sc2331-marlin");
@@ -351,7 +400,8 @@ static int marlin_probe(struct sdio_func *func, const struct sdio_device_id *id)
 	ret = misc_register(&marlin_misc);
 	if (!ret)
 		ret = device_create_file(marlin_misc.this_device, &dev_attr_status) ?:
-		      device_create_file(marlin_misc.this_device, &dev_attr_wlan);
+		      device_create_file(marlin_misc.this_device, &dev_attr_wlan) ?:
+		      device_create_file(marlin_misc.this_device, &dev_attr_bt);
 	dev_info(&func->dev, "Marlin SDIO function 1 enabled, /dev/marlin %s, irq %d\n", ret ? "FAILED" : "ready", m->irq);
 	return ret;
 err:
@@ -366,6 +416,8 @@ static void marlin_remove(struct sdio_func *func)
 
 	marlin = NULL;
 	sc2331_wlan_stop();
+	sprd_marlin_bt_stop();
+	device_remove_file(marlin_misc.this_device, &dev_attr_bt);
 	device_remove_file(marlin_misc.this_device, &dev_attr_wlan);
 	device_remove_file(marlin_misc.this_device, &dev_attr_status);
 	misc_deregister(&marlin_misc);
diff --git a/drivers/misc/sprd-sc2331-marlin.c b/drivers/misc/sprd-sc2331-marlin.c
index da841f012..e5e1a5df6 100644
--- a/drivers/misc/sprd-sc2331-marlin.c
+++ b/drivers/misc/sprd-sc2331-marlin.c
@@ -18,10 +18,17 @@
 #include <linux/of.h>
 #include <linux/regulator/consumer.h>
 #include <linux/serdev.h>
+#include <linux/sprd-marlin-sdio.h>
 #include <linux/spinlock.h>
 #include <linux/string.h>
 #include <linux/wait.h>
 
+#if IS_ENABLED(CONFIG_BT_HCIUART_SERDEV)
+#include <net/bluetooth/bluetooth.h>
+#include <net/bluetooth/hci_core.h>
+#include "../bluetooth/hci_uart.h"
+#endif
+
 #define MARLIN_FLAG		0x7e
 #define MARLIN_ESCAPE		0x7d
 #define MARLIN_ESCAPE_XOR	0x20
@@ -50,6 +57,11 @@ struct sprd_marlin {
 	struct regulator_bulk_data supplies[2];
 	struct device_node *sdio_host;
 	struct work_struct work;
+	bool serdev_open, bt_up, have_bd_addr;
+	u8 bd_addr[6];
+#if IS_ENABLED(CONFIG_BT_HCIUART_SERDEV)
+	struct hci_uart hu;
+#endif
 	const char *firmware_name;
 	u32 fdl_load_address;
 	spinlock_t rx_lock;
@@ -63,6 +75,9 @@ struct sprd_marlin {
 	u8 tx_buf[MARLIN_TX_SIZE];
 };
 
+static struct sprd_marlin *g_marlin;
+
+
 static u16 sprd_marlin_crc16(const u8 *data, size_t len)
 {
 	u16 crc = 0;
@@ -502,7 +517,9 @@ static int sprd_marlin_probe(struct serdev_device *serdev)
 	serdev_device_set_drvdata(serdev, marlin);
 	serdev_device_set_client_ops(serdev, &sprd_marlin_serdev_ops);
 
-	ret = devm_serdev_device_open(dev, serdev);
+	ret = serdev_device_open(serdev);
+	if (!ret)
+		marlin->serdev_open = true;
 	if (ret) {
 		of_node_put(marlin->sdio_host);
 		return dev_err_probe(dev, ret, "failed to open UART0\n");
@@ -512,6 +529,7 @@ static int sprd_marlin_probe(struct serdev_device *serdev)
 	serdev_device_set_flow_control(serdev, false);
 	dev_info(dev, "UART0 configured for %u baud\n", baud);
 
+	g_marlin = marlin;
 	INIT_WORK(&marlin->work, sprd_marlin_work);
 	schedule_work(&marlin->work);
 	return 0;
@@ -519,14 +537,200 @@ static int sprd_marlin_probe(struct serdev_device *serdev)
 
 static void sprd_marlin_remove(struct serdev_device *serdev)
 {
-	struct sprd_marlin *marlin = serdev_device_get_drvdata(serdev);
+	struct sprd_marlin *marlin = g_marlin;
 
+	sprd_marlin_bt_stop();
 	cancel_work_sync(&marlin->work);
+	if (marlin->serdev_open)
+		serdev_device_close(serdev);
+	g_marlin = NULL;
 	if (marlin->reset)
 		gpiod_set_value_cansleep(marlin->reset, 1);
 	of_node_put(marlin->sdio_host);
 }
 
+
+/* ---- Bluetooth over the same UART0 -------------------------------------------------------------------
+ *
+ * Once the firmware runs, UART0 carries plain H4 HCI at 3 Mbaud with hardware flow control, after a
+ * vendor command (opcode 0xfca0) with the controller's configuration: the pskey_bt.txt of Samsung's
+ * libbt-vendor, packed as its hw_pskey_send() does (196 bytes: the struct without its first word, with
+ * the alignment padding). The BD address (offset 76, little endian) is replaced by our own.
+ */
+#if IS_ENABLED(CONFIG_BT_HCIUART_SERDEV)
+#define MARLIN_PSKEY_OP		0xfca0
+#define MARLIN_PSKEY_ADDR_OFF	76
+#define MARLIN_BT_BAUD		3000000
+
+static const u8 marlin_pskey[196] = {
+	0x00, 0x01, 0x01, 0x01, 0x80, 0xba, 0x8c, 0x01, 0x00, 0x1f, 0x00, 0x00,
+	0x1e, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00,
+	0x02, 0x00, 0x00, 0x00, 0x03, 0x00, 0x00, 0x00, 0x04, 0x00, 0x00, 0x00,
+	0x05, 0x00, 0x00, 0x00, 0xfe, 0x8c, 0x41, 0xd0, 0xfe, 0x8c, 0x43, 0xd2,
+	0xfe, 0x8c, 0x43, 0xd4, 0xfe, 0x8c, 0x43, 0xd6, 0xfe, 0x8c, 0x04, 0xd8,
+	0xff, 0xff, 0x8d, 0xfe, 0x9b, 0x3f, 0x79, 0x83, 0xff, 0xa7, 0xff, 0x7f,
+	0x00, 0xe0, 0xf7, 0x3e, 0x11, 0xff, 0x00, 0x22, 0x2d, 0xae, 0x00, 0x01,
+	0x05, 0x0e, 0x00, 0x00, 0xff, 0xff, 0xff, 0xff, 0x30, 0x00, 0x3f, 0x00,
+	0x00, 0x00, 0x00, 0x00, 0x65, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+	0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+	0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+	0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+	0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+	0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+	0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+	0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+	0x00, 0x00, 0x00, 0x00,
+};
+
+struct marlin_h4 {
+	struct sk_buff *rx_skb;
+	struct sk_buff_head txq;
+};
+
+static int marlin_h4_open(struct hci_uart *hu)
+{
+	struct marlin_h4 *h4 = kzalloc(sizeof(*h4), GFP_KERNEL);
+
+	if (!h4)
+		return -ENOMEM;
+	skb_queue_head_init(&h4->txq);
+	hu->priv = h4;
+	return 0;
+}
+
+static int marlin_h4_flush(struct hci_uart *hu)
+{
+	struct marlin_h4 *h4 = hu->priv;
+
+	skb_queue_purge(&h4->txq);
+	return 0;
+}
+
+static int marlin_h4_close(struct hci_uart *hu)
+{
+	struct marlin_h4 *h4 = hu->priv;
+
+	skb_queue_purge(&h4->txq);
+	kfree_skb(h4->rx_skb);
+	hu->priv = NULL;
+	kfree(h4);
+	return 0;
+}
+
+static int marlin_h4_enqueue(struct hci_uart *hu, struct sk_buff *skb)
+{
+	struct marlin_h4 *h4 = hu->priv;
+
+	memcpy(skb_push(skb, 1), &hci_skb_pkt_type(skb), 1);
+	skb_queue_tail(&h4->txq, skb);
+	return 0;
+}
+
+static const struct h4_recv_pkt marlin_h4_recv_pkts[] = {
+	{ H4_RECV_ACL,   .recv = hci_recv_frame },
+	{ H4_RECV_SCO,   .recv = hci_recv_frame },
+	{ H4_RECV_EVENT, .recv = hci_recv_frame },
+	{ H4_RECV_ISO,   .recv = hci_recv_frame },
+};
+
+static int marlin_h4_recv(struct hci_uart *hu, const void *data, int count)
+{
+	struct marlin_h4 *h4 = hu->priv;
+
+	h4->rx_skb = h4_recv_buf(hu, h4->rx_skb, data, count, marlin_h4_recv_pkts, ARRAY_SIZE(marlin_h4_recv_pkts));
+	if (IS_ERR(h4->rx_skb)) {
+		int err = PTR_ERR(h4->rx_skb);
+
+		bt_dev_err(hu->hdev, "Frame reassembly failed (%d)", err);
+		h4->rx_skb = NULL;
+		return err;
+	}
+	return count;
+}
+
+static struct sk_buff *marlin_h4_dequeue(struct hci_uart *hu)
+{
+	struct marlin_h4 *h4 = hu->priv;
+
+	return skb_dequeue(&h4->txq);
+}
+
+static int marlin_bt_setup(struct hci_uart *hu)
+{
+	struct sprd_marlin *m = g_marlin;
+	u8 pskey[sizeof(marlin_pskey)];
+	struct sk_buff *skb;
+
+	serdev_device_set_flow_control(hu->serdev, true);
+	memcpy(pskey, marlin_pskey, sizeof(pskey));
+	if (m->have_bd_addr)
+		memcpy(pskey + MARLIN_PSKEY_ADDR_OFF, m->bd_addr, 6);
+	skb = __hci_cmd_sync(hu->hdev, MARLIN_PSKEY_OP, sizeof(pskey), pskey, HCI_INIT_TIMEOUT);
+	if (IS_ERR(skb)) {
+		bt_dev_err(hu->hdev, "pskey configuration failed (%ld)", PTR_ERR(skb));
+		return PTR_ERR(skb);
+	}
+	bt_dev_info(hu->hdev, "controller configured (%d bytes of reply)", skb->len);
+	kfree_skb(skb);
+	return 0;
+}
+
+static const struct hci_uart_proto marlin_h4p = {
+	.id		= HCI_UART_H4,
+	.name		= "sc2331",
+	.manufacturer	= 65535,
+	.init_speed	= MARLIN_BT_BAUD,
+	.open		= marlin_h4_open,
+	.close		= marlin_h4_close,
+	.flush		= marlin_h4_flush,
+	.setup		= marlin_bt_setup,
+	.recv		= marlin_h4_recv,
+	.enqueue	= marlin_h4_enqueue,
+	.dequeue	= marlin_h4_dequeue,
+};
+
+int sprd_marlin_bt_start(const u8 *bd_addr)
+{
+	struct sprd_marlin *m = g_marlin;
+	int ret;
+
+	if (!m)
+		return -ENODEV;
+	if (m->bt_up)
+		return -EBUSY;
+	if (bd_addr) {
+		memcpy(m->bd_addr, bd_addr, 6);
+		m->have_bd_addr = true;
+	}
+	if (m->serdev_open) {			/* the loader is done with the port */
+		serdev_device_close(m->serdev);
+		m->serdev_open = false;
+	}
+	m->hu.serdev = m->serdev;
+	serdev_device_set_drvdata(m->serdev, &m->hu);
+	ret = hci_uart_register_device(&m->hu, &marlin_h4p);
+	if (ret) {
+		dev_err(&m->serdev->dev, "cannot register the Bluetooth controller: %d\n", ret);
+		return ret;
+	}
+	m->bt_up = true;
+	dev_info(&m->serdev->dev, "Bluetooth controller registered\n");
+	return 0;
+}
+EXPORT_SYMBOL_GPL(sprd_marlin_bt_start);
+
+void sprd_marlin_bt_stop(void)
+{
+	struct sprd_marlin *m = g_marlin;
+
+	if (m && m->bt_up) {
+		hci_uart_unregister_device(&m->hu);
+		m->bt_up = false;
+	}
+}
+EXPORT_SYMBOL_GPL(sprd_marlin_bt_stop);
+#endif /* CONFIG_BT_HCIUART_SERDEV */
+
 static const struct of_device_id sprd_marlin_of_match[] = {
 	{ .compatible = "sprd,sc2331-marlin" },
 	{}
diff --git a/drivers/misc/sprd-sc2331-wlan.c b/drivers/misc/sprd-sc2331-wlan.c
index e290299d3..ed10ceaf6 100644
--- a/drivers/misc/sprd-sc2331-wlan.c
+++ b/drivers/misc/sprd-sc2331-wlan.c
@@ -538,7 +538,7 @@ static int sc_thread(void *arg)
 			did |= sc_tx(sc);
 			if (did) {
 				sc->last_active = jiffies;
-			} else if (idle_sleep_ms && sc->opened &&
+			} else if (idle_sleep_ms && sc->opened && !marlin_sdio_held(sc->m) &&
 				   time_after(jiffies, sc->last_active + msecs_to_jiffies(idle_sleep_ms))) {
 				marlin_sdio_sleep(sc->m);
 				sc->awake = false;
diff --git a/include/linux/sprd-marlin-sdio.h b/include/linux/sprd-marlin-sdio.h
index 988cca97c..85cd2dbd6 100644
--- a/include/linux/sprd-marlin-sdio.h
+++ b/include/linux/sprd-marlin-sdio.h
@@ -14,8 +14,18 @@ int marlin_sdio_chn_read(struct marlin_sdio *m, unsigned int chn, void *buf, int
 int marlin_sdio_chn_write(struct marlin_sdio *m, unsigned int chn, const void *buf, int len);
 void marlin_sdio_set_irq_cb(struct marlin_sdio *m, void (*cb)(void *), void *data);
 int marlin_sdio_wake(struct marlin_sdio *m);
+void marlin_sdio_hold_awake(struct marlin_sdio *m, bool hold);
+bool marlin_sdio_held(struct marlin_sdio *m);
 void marlin_sdio_sleep(struct marlin_sdio *m);
 
+#if IS_ENABLED(CONFIG_BT_HCIUART_SERDEV)
+int sprd_marlin_bt_start(const u8 *bd_addr);
+void sprd_marlin_bt_stop(void);
+#else
+static inline int sprd_marlin_bt_start(const u8 *bd_addr) { return -ENODEV; }
+static inline void sprd_marlin_bt_stop(void) { }
+#endif
+
 #if IS_ENABLED(CONFIG_SPRD_SC2331_WLAN)
 int sc2331_wlan_start(struct marlin_sdio *m, const u8 *mac);
 void sc2331_wlan_stop(void);
