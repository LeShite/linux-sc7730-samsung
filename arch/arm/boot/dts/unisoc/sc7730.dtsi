/*
 * Spreadtrum SC7730 (SC8830 family) SoC
 *
 * Addresses and interrupts are taken from the vendor 3.10 kernel
 * (sprd-scx35_3.dtsi).
 */

#include <dt-bindings/interrupt-controller/arm-gic.h>
#include <dt-bindings/interrupt-controller/irq.h>

/ {
	#address-cells = <1>;
	#size-cells = <1>;
	interrupt-parent = <&gic>;

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;

		cpu0: cpu@f00 {
			device_type = "cpu";
			compatible = "arm,cortex-a7";
			reg = <0xf00>;
		};

		cpu1: cpu@f01 {
			device_type = "cpu";
			compatible = "arm,cortex-a7";
			reg = <0xf01>;
		};

		cpu2: cpu@f02 {
			device_type = "cpu";
			compatible = "arm,cortex-a7";
			reg = <0xf02>;
		};

		cpu3: cpu@f03 {
			device_type = "cpu";
			compatible = "arm,cortex-a7";
			reg = <0xf03>;
		};
	};

	clk32k: clock-32k {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <32768>;
		clock-output-names = "clk32k";
	};

	soc {
		compatible = "simple-bus";
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		gic: interrupt-controller@12001000 {
			compatible = "arm,cortex-a7-gic";
			reg = <0x12001000 0x1000>,
			      <0x12002000 0x2000>;
			interrupt-controller;
			#interrupt-cells = <3>;
		};

		/* AON GPTIMER0; the second range holds the AON APB clock gates */
		timer@40050000 {
			compatible = "sprd,sc8830-timer";
			reg = <0x40050000 0x1000>,
			      <0x402e0000 0x8>;
			interrupts = <GIC_SPI 28 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&clk32k>;
		};

		gpu: gpu@60000000 {
			compatible = "arm,mali-400";
			reg = <0x60000000 0x10000>;
			/* every unit of the MP2 GPU shares one interrupt line */
			interrupts = <GIC_SPI 39 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 39 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 39 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 39 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 39 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 39 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "gp", "gpmmu", "pp0", "ppmmu0",
					  "pp1", "ppmmu1";
			status = "disabled";
		};
	};
};
