// SPDX-License-Identifier: GPL-2.0
/*
 * Spreadtrum SC7730 (SC8830 family) SoC
 *
 * Addresses and interrupts are taken from the vendor 3.10 kernel
 * (sprd-scx35_3.dtsi).
 */

#include <dt-bindings/interrupt-controller/arm-gic.h>
#include <dt-bindings/interrupt-controller/irq.h>

/ {
	#address-cells = <1>;
	#size-cells = <1>;
	interrupt-parent = <&intc>;

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;

		cpu0: cpu@f00 {
			device_type = "cpu";
			compatible = "arm,cortex-a7";
			reg = <0xf00>;
		};

		cpu1: cpu@f01 {
			device_type = "cpu";
			compatible = "arm,cortex-a7";
			reg = <0xf01>;
		};

		cpu2: cpu@f02 {
			device_type = "cpu";
			compatible = "arm,cortex-a7";
			reg = <0xf02>;
		};

		cpu3: cpu@f03 {
			device_type = "cpu";
			compatible = "arm,cortex-a7";
			reg = <0xf03>;
		};
	};

	clk32k: clock-32k {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <32768>;
		clock-output-names = "clk32k";
	};

	/* set up by gpu_pd: the 384 MHz parent, divider 1 */
	gpu_clk: clock-gpu {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <384000000>;
		clock-output-names = "gpu";
	};

	soc {
		compatible = "simple-bus";
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		gic: interrupt-controller@12001000 {
			compatible = "arm,cortex-a7-gic";
			reg = <0x12001000 0x1000>,
			      <0x12002000 0x2000>;
			interrupt-controller;
			#interrupt-cells = <3>;
			interrupt-parent = <&gic>;
		};

		/*
		 * Wakeup mirror of the GIC: with all cores in WFI the GIC clock
		 * stops and only sources enabled here can wake the system.
		 */
		intc: interrupt-controller@71400000 {
			compatible = "sprd,sc8830-intc";
			reg = <0x71400000 0x1000>,
			      <0x71500000 0x1000>,
			      <0x71600000 0x1000>,
			      <0x71700000 0x1000>,
			      <0x71300000 0x4>;
			reg-names = "intc0", "intc1", "intc2", "intc3", "eb";
			interrupt-controller;
			#interrupt-cells = <3>;
			interrupt-parent = <&gic>;
		};

		/* AON GPTIMER0; the second range holds the AON APB clock gates */
		timer@40050000 {
			compatible = "sprd,sc8830-timer";
			reg = <0x40050000 0x1000>,
			      <0x402e0000 0x8>;
			interrupts = <GIC_SPI 28 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&clk32k>;
		};

		/* SD card slot (vendor "sdio0") */
		sdc: mmc@20300000 {
			compatible = "sprd,sc8830-sdhci";
			reg = <0x20300000 0x1000>;
			interrupts = <GIC_SPI 57 IRQ_TYPE_LEVEL_HIGH>;
			sprd,delays = <0x3 0x3 0x3>;
			status = "disabled";
		};

		/* eMMC (vendor "sdio3"), set up by the bootloader */
		emmc: mmc@20600000 {
			compatible = "sprd,sc8830-sdhci";
			reg = <0x20600000 0x1000>;
			interrupts = <GIC_SPI 60 IRQ_TYPE_LEVEL_HIGH>;
			sprd,delays = <0xa 0x2 0x2>;
			status = "disabled";
		};

		/*
		 * PMU PD_GPU_TOP_CFG, AON APB_EB0 (shared), the PMU gates of the
		 * GPU clock sources and the GPU APB block
		 */
		gpu_pd: power-controller@402b0020 {
			compatible = "sprd,sc8830-gpu-pd";
			reg = <0x402b0020 0x4>,
			      <0x402e0000 0x4>,
			      <0x402b011c 0x4>,
			      <0x60100000 0x8>;
			reg-names = "pmu", "aon", "gate", "gpu";
			#power-domain-cells = <0>;
		};

		gpu: gpu@60000000 {
			compatible = "arm,mali-400";
			reg = <0x60000000 0x10000>;
			/* every unit of the MP2 GPU shares one interrupt line */
			interrupts = <GIC_SPI 39 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 39 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 39 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 39 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 39 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 39 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 39 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "gp", "gpmmu", "pp0", "ppmmu0",
					  "pp1", "ppmmu1", "pmu";
			clocks = <&gpu_clk>, <&gpu_clk>;
			clock-names = "bus", "core";
			power-domains = <&gpu_pd>;
		};
	};
};
