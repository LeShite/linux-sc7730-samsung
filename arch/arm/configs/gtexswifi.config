# Samsung Galaxy Tab A 7.0 (2016) Wi-Fi (SM-T280), stage 1 "first light".
# Use on top of allnoconfig:
#   make ARCH=arm allnoconfig KCONFIG_ALLCONFIG=arch/arm/configs/gtexswifi.config

CONFIG_LOCALVERSION="-gtexswifi"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_DEFAULT_HOSTNAME="gtexswifi"
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_PREEMPT_VOLUNTARY=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_LOG_BUF_SHIFT=18
CONFIG_PRINTK_TIME=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_KERNEL_XZ=y
CONFIG_KALLSYMS=y
CONFIG_PANIC_TIMEOUT=0
# 32-bit time_t syscalls; allnoconfig drops them, older userspace needs them
CONFIG_COMPAT_32BIT_TIME=y

# Platform (allnoconfig would even turn the MMU off)
CONFIG_MMU=y
CONFIG_ARCH_MULTI_V7=y
CONFIG_ARCH_SPRD=y
CONFIG_SMP=y
CONFIG_NR_CPUS=4
CONFIG_HIGHMEM=y
CONFIG_VFP=y
CONFIG_NEON=y
CONFIG_KERNEL_MODE_NEON=y
CONFIG_ARM_THUMB=y
CONFIG_ARM_UNWIND=y

# Boot: our DTB is appended to zImage, so SBOOT's copy and cmdline are ignored
CONFIG_ARM_APPENDED_DTB=y
CONFIG_ARM_ATAG_DTB_COMPAT=y
CONFIG_CMDLINE="console=tty0 loglevel=8 ignore_loglevel panic=0 fbcon=nodefer"
CONFIG_CMDLINE_FORCE=y

# Display: the panel keeps scanning out the bootloader framebuffer
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
# fbcon goes through a shadow buffer that a worker copies to the screen;
# after a panic that worker never runs, so draw panics straight to it
CONFIG_DRM_PANIC=y
CONFIG_DRM_PANIC_SCREEN="kmsg"

# Built-in bring-up initramfs with our own tiny /init
CONFIG_INITRAMFS_SOURCE="/home/nigga/batocera-t280/initramfs/initramfs.list"

# Storage: eMMC (and later the SD slot)
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_BLOCK_MINORS=32
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_SPRD_SC8830=y
CONFIG_PARTITION_ADVANCED=y
CONFIG_EFI_PARTITION=y
CONFIG_MSDOS_PARTITION=y

# Crash log kept in RAM, read back by the next boot of this kernel
CONFIG_MISC_FILESYSTEMS=y
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_RAM=y

# Userspace basics
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
