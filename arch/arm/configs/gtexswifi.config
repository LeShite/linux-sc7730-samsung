# Samsung Galaxy Tab A 7.0 (2016) Wi-Fi (SM-T280), stage 1 "first light".
# Use on top of allnoconfig:
#   make ARCH=arm allnoconfig KCONFIG_ALLCONFIG=arch/arm/configs/gtexswifi.config

CONFIG_LOCALVERSION="-gtexswifi"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_DEFAULT_HOSTNAME="gtexswifi"
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_PREEMPT_VOLUNTARY=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_LOG_BUF_SHIFT=18
CONFIG_PRINTK_TIME=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_KERNEL_XZ=y
CONFIG_KALLSYMS=y
CONFIG_PANIC_TIMEOUT=0
# 32-bit time_t syscalls; allnoconfig drops them, older userspace needs them
CONFIG_COMPAT_32BIT_TIME=y

# Platform (allnoconfig would even turn the MMU off)
CONFIG_MMU=y
CONFIG_ARCH_MULTI_V7=y
CONFIG_ARCH_SPRD=y
CONFIG_SMP=y
CONFIG_NR_CPUS=4
CONFIG_HIGHMEM=y
CONFIG_VFP=y
CONFIG_NEON=y
CONFIG_KERNEL_MODE_NEON=y
CONFIG_ARM_THUMB=y
CONFIG_ARM_UNWIND=y
# Vector-page helpers (kuser): glibc/libgcc read the helper version at 0xffff0ffc and any
# process that does so is killed with SIGSEGV when this is off (python3, wireplumber, lircd)
CONFIG_KUSER_HELPERS=y

# Sound: no codec driver yet, so a virtual ALSA card that swallows the audio. Without any card
# VICE aborts ("sound initialization failed for device alsa") and Batocera's audio setup waits ~20 s
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_PROC_FS=y
CONFIG_SND_DRIVERS=y
CONFIG_SND_PCM_TIMER=y
CONFIG_SND_DUMMY=y

# Boot: our DTB is appended to zImage, so SBOOT's copy and cmdline are ignored
CONFIG_ARM_APPENDED_DTB=y
CONFIG_ARM_ATAG_DTB_COMPAT=y
CONFIG_CMDLINE="label=BATOCERA console=tty0 loglevel=7 panic=0 fbcon=nodefer"
CONFIG_CMDLINE_FORCE=y

# Display: the panel keeps scanning out the bootloader framebuffer
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
# fbcon goes through a shadow buffer that a worker copies to the screen;
# after a panic that worker never runs, so draw panics straight to it
CONFIG_DRM_PANIC=y
CONFIG_DRM_PANIC_SCREEN="kmsg"

# Built-in initramfs: Batocera's own initrd (its /init renamed to
# /init.batocera) plus our tiny /init, which shows diagnostics and then hands
# over. Files extracted as a normal user are mapped to root.
CONFIG_INITRAMFS_SOURCE="/home/nigga/batocera-t280/build/batocera-initrd /home/nigga/batocera-t280/initramfs/initramfs.list"
CONFIG_INITRAMFS_ROOT_UID=1000
CONFIG_INITRAMFS_ROOT_GID=1000

# Storage: eMMC (and later the SD slot)
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_BLOCK_MINORS=32
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_SPRD_SC8830=y
CONFIG_PARTITION_ADVANCED=y
CONFIG_EFI_PARTITION=y
CONFIG_MSDOS_PARTITION=y

# Batocera: its initramfs mounts LABEL=BATOCERA, loop-mounts the squashfs
# boot/batocera and puts a tmpfs overlay on top
CONFIG_BLK_DEV=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_EXFAT_FS=y
CONFIG_FAT_DEFAULT_IOCHARSET="utf8"
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_SQUASHFS_LZ4=y
CONFIG_SQUASHFS_LZO=y
CONFIG_OVERLAY_FS=y
CONFIG_TMPFS_XATTR=y
CONFIG_FUSE_FS=y
CONFIG_INOTIFY_USER=y
# udev, dbus and friends
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_PACKET=y
# GPU: Mali-400 MP2 through Lima. Batocera's Mesa only has kmsro targets
# (sun4i-drm, rockchip, ...), so simpledrm introduces itself as sun4i-drm,
# the display driver of the H3 build this userspace comes from.
CONFIG_PM=y
CONFIG_SPRD_SC8830_GPU_PD=y
CONFIG_DRM_LIMA=y
CONFIG_DRM_SIMPLEDRM_NAME="sun4i-drm"

# Touchscreen: Melfas MIP4 on I2C1, IRQ on GPIO 238, powered from the
# SC2723 LDO vddsim2 through the ADI bus
CONFIG_GPIOLIB=y
CONFIG_GPIO_SPRD=y
CONFIG_I2C=y
CONFIG_I2C_SPRD_SC8830=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_SC2723=y
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_MELFAS_MIP4=y

# input: evdev for EmulationStation, uinput for Batocera's pad mapper
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_JOYDEV=y
CONFIG_INPUT_MISC=y
CONFIG_INPUT_UINPUT=y

# Crash log kept in RAM, read back by the next boot of this kernel
CONFIG_MISC_FILESYSTEMS=y
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_RAM=y

# Userspace basics
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
