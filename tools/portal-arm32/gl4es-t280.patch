diff --git a/src/gl/sync.c b/src/gl/sync.c
new file mode 100644
index 0000000..a881479
--- /dev/null
+++ b/src/gl/sync.c
@@ -0,0 +1,65 @@
+// GL_ARB_sync (OpenGL 3.2 sync objects) for programs that insist on it (Source's togl asks for a fence extension).
+// GLES2 has no sync objects: a fence is a counter token, and waiting on one drains the GPU with glFinish, so
+// "signaled" is always true when the wait returns.
+#include <stdint.h>
+
+#include "attributes.h"
+#include "gl4es.h"
+
+#define SYNC_GPU_COMMANDS_COMPLETE 0x9117
+#define SYNC_OBJECT_TYPE           0x9112
+#define SYNC_CONDITION             0x9113
+#define SYNC_STATUS                0x9114
+#define SYNC_FLAGS                 0x9115
+#define SIGNALED                   0x9119
+#define SYNC_FENCE                 0x9116
+#define ALREADY_SIGNALED           0x911A
+#define CONDITION_SATISFIED        0x911C
+
+void APIENTRY_GL4ES gl4es_glFinish(void);
+
+static uintptr_t sync_counter = 0;
+
+void* APIENTRY_GL4ES gl4es_glFenceSync(GLenum condition, GLbitfield flags) {
+    (void)condition; (void)flags;
+    return (void*)(++sync_counter);
+}
+
+GLboolean APIENTRY_GL4ES gl4es_glIsSync(void* sync) {
+    return sync != NULL;
+}
+
+void APIENTRY_GL4ES gl4es_glDeleteSync(void* sync) {
+    (void)sync;
+}
+
+GLenum APIENTRY_GL4ES gl4es_glClientWaitSync(void* sync, GLbitfield flags, GLuint64 timeout) {
+    (void)sync; (void)flags; (void)timeout;
+    gl4es_glFinish();
+    return CONDITION_SATISFIED;
+}
+
+void APIENTRY_GL4ES gl4es_glWaitSync(void* sync, GLbitfield flags, GLuint64 timeout) {
+    (void)sync; (void)flags; (void)timeout;
+}
+
+void APIENTRY_GL4ES gl4es_glGetSynciv(void* sync, GLenum pname, GLsizei bufSize, GLsizei* length, GLint* values) {
+    (void)sync;
+    if (bufSize < 1 || !values)
+        return;
+    switch (pname) {
+        case SYNC_OBJECT_TYPE: values[0] = SYNC_FENCE; break;
+        case SYNC_CONDITION:   values[0] = SYNC_GPU_COMMANDS_COMPLETE; break;
+        case SYNC_STATUS:      values[0] = SIGNALED; break;
+        default:               values[0] = 0; break;
+    }
+    if (length)
+        *length = 1;
+}
+
+AliasExport(void*,glFenceSync,,(GLenum condition, GLbitfield flags));
+AliasExport(GLboolean,glIsSync,,(void* sync));
+AliasExport(void,glDeleteSync,,(void* sync));
+AliasExport(GLenum,glClientWaitSync,,(void* sync, GLbitfield flags, GLuint64 timeout));
+AliasExport(void,glWaitSync,,(void* sync, GLbitfield flags, GLuint64 timeout));
+AliasExport(void,glGetSynciv,,(void* sync, GLenum pname, GLsizei bufSize, GLsizei* length, GLint* values));
