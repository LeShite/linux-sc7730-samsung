+// the contexts are created by the application (SDL, ...) and not by glXCreateContext, so gl4es has to make a
+// state for each one when it first becomes current, as the AGL layer does
+typedef struct { EGLContext ctx; void* state; } egl_ctxstate_t;
+static egl_ctxstate_t egl_ctxstates[16];
+
+void* NewGLState(void* shared_glstate, int es2only);
+void ActivateGLState(void* new_glstate);
+
+static void egl_activate_state(EGLContext ctx) {
+    int i, free_slot = -1;
+    for (i = 0; i < 16; i++) {
+        if (egl_ctxstates[i].ctx == ctx)
+            break;
+        if (free_slot < 0 && !egl_ctxstates[i].ctx)
+            free_slot = i;
+    }
+    if (i == 16) {
+        if (free_slot < 0)
+            return;
+        i = free_slot;
+        egl_ctxstates[i].ctx = ctx;
+        egl_ctxstates[i].state = NewGLState(NULL, 0);
+    }
+
+    ActivateGLState(egl_ctxstates[i].state);
+}
+
 EGLBoolean gl4es_eglMakeCurrent(EGLDisplay dpy, EGLSurface draw, EGLSurface read, EGLContext ctx) {
     LOAD_EGL(eglMakeCurrent);
-    return egl_eglMakeCurrent(dpy, draw, read, ctx);
+    EGLBoolean r = egl_eglMakeCurrent(dpy, draw, read, ctx);
+    if (r && ctx != EGL_NO_CONTEXT)
+        egl_activate_state(ctx);
+    return r;
 }
 
